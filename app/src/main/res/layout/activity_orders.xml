<ScrollView xmlns:android="http://schemas.android.com/apk/res/android" android:layout_width="match_parent" android:layout_height="match_parent" android:padding="16dp">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Фильтры:" android:textStyle="bold" android:layout_marginBottom="8dp"/>
        
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Проект:" />
        <Spinner android:id="@+id/spinnerProject" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>

        <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Производитель:" />
        <Spinner android:id="@+id/spinnerManufacturer" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginBottom="8dp"/>

        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:layout_marginBottom="16dp">
            <CheckBox android:id="@+id/cbReceived" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Получено" />
            <CheckBox android:id="@+id/cbNotReceived" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Не получено" />
        </LinearLayout>

        <Button android:id="@+id/btnApplyFilters" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Применить фильтры" />
        
        <TextView android:id="@+id/tvOrdersResult" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="16dp" android:textIsSelectable="true" android:fontFamily="monospace"/>
    </LinearLayout>
</ScrollView>